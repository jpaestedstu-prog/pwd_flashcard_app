rules_version = '2';

// PHASE A — Anonymous-auth + owner-scoped writes.
//
// Every owner-scoped doc carries `owner_uid` (the writer's
// FirebaseAuth.currentUser.uid). Reads stay open to any signed-in user
// for now (teacher dashboards need to fetch student profiles); writes
// are pinned to the owner.
//
// To deploy: enable Anonymous sign-in in the Firebase console
// (Authentication → Sign-in method → Anonymous → Enable), then
// `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // True when the existing doc has no owner_uid (legacy/migrated) and
    // the incoming write stamps the requester as owner. Lets
    // OwnerUidMigration claim pre-auth docs without weakening the rule
    // for already-owned ones.
    function claimingUnowned() {
      return signedIn()
        && (!('owner_uid' in resource.data) || resource.data.owner_uid == null)
        && request.resource.data.owner_uid == request.auth.uid;
    }

    // True when the writer is presenting a valid, unused recovery code
    // for [profileId] and is stamping themselves as the new owner. The
    // client embeds `_recovery_code` on the patch payload so the rule
    // can verify the matching `recovery_codes/{code}` doc references
    // this profile and has not been redeemed yet. Used by the
    // cross-device profile recovery flow.
    function claimingViaRecovery(profileId) {
      return signedIn()
        && '_recovery_code' in request.resource.data
        && exists(/databases/$(database)/documents/recovery_codes/$(request.resource.data._recovery_code))
        && get(/databases/$(database)/documents/recovery_codes/$(request.resource.data._recovery_code)).data.profile_id == profileId
        && get(/databases/$(database)/documents/recovery_codes/$(request.resource.data._recovery_code)).data.used_at == null
        && request.resource.data.owner_uid == request.auth.uid;
    }

    function ownsProfile(profileId) {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(profileId))
        && get(/databases/$(database)/documents/profiles/$(profileId)).data.owner_uid == request.auth.uid;
    }

    function ownsClassroomTeacher(classroomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/classrooms/$(classroomId))
        && ownsProfile(
          get(/databases/$(database)/documents/classrooms/$(classroomId)).data.teacher_id
        );
    }

    function ownsHomeGroupOwner(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/home_groups/$(groupId))
        && ownsProfile(
          get(/databases/$(database)/documents/home_groups/$(groupId)).data.owner_profile_id
        );
    }

    // A live session is keyed by either a classroom id (teacher-hosted) or a
    // home-group id (parent-hosted). The host is whoever owns the matching
    // classroom or home group.
    function ownsLiveSession(sessionKey) {
      return ownsClassroomTeacher(sessionKey)
        || ownsHomeGroupOwner(sessionKey);
    }

    // ─── Profiles ──────────────────────────────────────
    // Reads are open to any signed-in user (educator dashboards need
    // roster lookups). Writes are owner-scoped, with two extra paths:
    //   • student / child profiles cannot mutate their own `learning_level`
    //     — only an educator override (run from the teacher / parent device,
    //     which writes from a different uid) may change it.
    //   • A classroom teacher / home-group owner may patch ONLY the
    //     learner's `name` (and `updated_at`) when their roster rename
    //     just produced a matching `*_audit/.../events/...` row stamped
    //     with their own `actor_uid`. Implemented via [educatorRenamePatch]
    //     so the rule stays O(1) (no listing of subcollections).
    match /profiles/{profileId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.owner_uid == request.auth.uid;
      allow update: if (isOwner(resource.data.owner_uid)
            && !(resource.data.role in [0, 3]
              && request.resource.data.learning_level
                != resource.data.learning_level))
        || claimingUnowned()
        || claimingViaRecovery(profileId)
        || educatorRenamePatch(profileId);
      allow delete: if isOwner(resource.data.owner_uid);
    }

    // True when the incoming write is an educator-driven name-only patch
    // that has a corresponding audit row stamped with the requester's
    // uid. The audit row is written by the same client just before the
    // profile patch (see [FirestoreRepository.updateMemberDisplayName] /
    // [updateHomeGroupMemberDisplayName]) so the `exists()` check below
    // resolves on the server side of the same request.
    function educatorRenamePatch(profileId) {
      return signedIn()
        // The client may include exactly one scoping hint (classroom or
        // home group) alongside the rename. Anything else makes the
        // patch ineligible for this branch.
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'name',
            'updated_at',
            '_rename_actor_classroom_id',
            '_rename_actor_home_group_id',
          ])
        && (
          // Classroom rename: any classroom_members row referencing this
          // profileId in a classroom owned by the requester. The client
          // passes the classroom id as a hint on the patch payload so
          // the rule check stays O(1).
          existsClassroomRenameAudit(profileId)
          || existsHomeGroupRenameAudit(profileId)
        );
    }

    // Helper: does any classroom_members row referencing this profileId
    // also have its parent classroom owned by the requester? We can't
    // list subcollections from rules, so we look up the membership doc
    // by the educator's hint — the client writes
    // `_rename_actor_classroom_id` on the patch payload. If the field
    // is present, we verify ownership via that classroom's teacher.
    function existsClassroomRenameAudit(profileId) {
      return ('_rename_actor_classroom_id' in request.resource.data)
        && exists(/databases/$(database)/documents/classroom_members/$(request.resource.data._rename_actor_classroom_id + '_' + profileId))
        && ownsClassroomTeacher(request.resource.data._rename_actor_classroom_id);
    }

    // Mirror for home-group rename — client passes
    // `_rename_actor_home_group_id`.
    function existsHomeGroupRenameAudit(profileId) {
      return ('_rename_actor_home_group_id' in request.resource.data)
        && exists(/databases/$(database)/documents/home_group_members/$(request.resource.data._rename_actor_home_group_id + '_' + profileId))
        && ownsHomeGroupOwner(request.resource.data._rename_actor_home_group_id);
    }

    // ─── Progress ──────────────────────────────────────
    match /progress/{profileId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.owner_uid == request.auth.uid;
      allow update: if isOwner(resource.data.owner_uid)
        || claimingUnowned()
        || claimingViaRecovery(profileId);
      allow delete: if isOwner(resource.data.owner_uid);
    }

    // ─── Custom flashcards ─────────────────────────────
    // Custom cards belong to a profile (via owner_uid). On recovery,
    // the new uid re-stamps each card with itself; the `_recovery_code`
    // hint lets the rule verify the recovering uid actually possesses
    // a valid code for the profile that owns the card.
    match /custom_cards/{cardId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.owner_uid == request.auth.uid;
      allow update: if isOwner(resource.data.owner_uid)
        || claimingUnowned()
        || (
          '_recovery_code' in request.resource.data
          && exists(/databases/$(database)/documents/recovery_codes/$(request.resource.data._recovery_code))
          && get(/databases/$(database)/documents/recovery_codes/$(request.resource.data._recovery_code)).data.profile_owner_uid == resource.data.owner_uid
          && get(/databases/$(database)/documents/recovery_codes/$(request.resource.data._recovery_code)).data.used_at == null
          && request.resource.data.owner_uid == request.auth.uid
        );
      allow delete: if isOwner(resource.data.owner_uid);
    }

    // ─── Settings (per-device, doc id == uid) ──────────
    match /settings/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ─── Session analytics ─────────────────────────────
    match /session_logs/{autoId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.owner_uid == request.auth.uid;
      allow update, delete: if isOwner(resource.data.owner_uid);
    }

    // ─── Achievements (subcollection of profileId) ─────
    match /achievements/{profileId}/items/{itemId} {
      allow read: if signedIn();
      allow write: if ownsProfile(profileId);
    }

    // ─── Shop purchases (subcollection of profileId) ───
    match /shop_purchases/{profileId}/items/{itemId} {
      allow read: if signedIn();
      allow write: if ownsProfile(profileId);
    }

    // ─── Shop equipped (per profile + item type) ───────
    // Equipped-item docs carry `profile_id`. The recovery branch accepts
    // a write when the requester possesses a valid code for the profile
    // referenced by `profile_id` on the doc.
    match /shop_equipped/{docId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.owner_uid == request.auth.uid;
      allow update: if isOwner(resource.data.owner_uid)
        || claimingUnowned()
        || (
          '_recovery_code' in request.resource.data
          && exists(/databases/$(database)/documents/recovery_codes/$(request.resource.data._recovery_code))
          && get(/databases/$(database)/documents/recovery_codes/$(request.resource.data._recovery_code)).data.profile_id == resource.data.profile_id
          && get(/databases/$(database)/documents/recovery_codes/$(request.resource.data._recovery_code)).data.used_at == null
          && request.resource.data.owner_uid == request.auth.uid
        );
      allow delete: if isOwner(resource.data.owner_uid);
    }

    // ─── App state (tutorial flags, daily challenge, etc.) ─
    // `app_state` doc ids embed the profile id (e.g.
    // `tutorial_seen_{profileId}`, `daily_streak_{profileId}`). The
    // recovery branch accepts a write when the doc's existing `owner_uid`
    // matches the recovery code's `profile_owner_uid` — the same
    // pre-condition we use on `custom_cards`.
    match /app_state/{key} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.owner_uid == request.auth.uid;
      allow update: if isOwner(resource.data.owner_uid)
        || claimingUnowned()
        || (
          '_recovery_code' in request.resource.data
          && exists(/databases/$(database)/documents/recovery_codes/$(request.resource.data._recovery_code))
          && get(/databases/$(database)/documents/recovery_codes/$(request.resource.data._recovery_code)).data.profile_owner_uid == resource.data.owner_uid
          && get(/databases/$(database)/documents/recovery_codes/$(request.resource.data._recovery_code)).data.used_at == null
          && request.resource.data.owner_uid == request.auth.uid
        );
      allow delete: if isOwner(resource.data.owner_uid);
    }

    // ─── Classrooms ────────────────────────────────────
    // Reads are open to any signed-in user so students can look up by
    // code at join time. Writes are gated on the writer owning the
    // teacher profile referenced by `teacher_id`.
    match /classrooms/{classroomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && ownsProfile(request.resource.data.teacher_id);
      allow update, delete: if signedIn()
        && ownsProfile(resource.data.teacher_id);
    }

    // ─── Classroom membership ──────────────────────────
    // The teacher of the classroom may add/remove anyone; a profile
    // owner may add/remove themselves (student-initiated join/leave).
    match /classroom_members/{memberId} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        ownsClassroomTeacher(request.resource.data.classroom_id)
        || ownsProfile(request.resource.data.profile_id)
      );
      allow update: if signedIn() && (
        ownsClassroomTeacher(resource.data.classroom_id)
        || ownsProfile(resource.data.profile_id)
      );
      allow delete: if signedIn() && (
        ownsClassroomTeacher(resource.data.classroom_id)
        || ownsProfile(resource.data.profile_id)
      );
    }

    // ─── Classroom audit log (immutable) ───────────────
    // Reads: only the teacher who owns the classroom.
    // Creates: any signed-in user, but they must stamp their own uid as
    //   actor_uid (no impersonation). Append-only — no updates/deletes.
    match /classroom_audit/{classroomId}/events/{eventId} {
      allow read: if ownsClassroomTeacher(classroomId);
      allow create: if signedIn()
        && request.resource.data.actor_uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── Progress audit log (server-written) ───────────
    // Reads: the profile owner (so a kid can see if their last claim was
    //   reverted) and any signed-in user (teachers triaging suspicious
    //   accounts). Writes: blocked from clients. Historically a Cloud
    //   Function would have written here, but Cloud Functions require
    //   the Blaze plan — on the free Spark plan we ship without it.
    //   The rule stays so clients can never forge audit rows.
    match /progress_audit/{profileId}/events/{eventId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ─── Rate-limit counters (server-only writes) ──────
    // Owner can read their own counter for transparency. Writes are
    // blocked from clients; only a Blaze-tier Cloud Function would be
    // allowed to bump these (none is deployed in this free-tier setup).
    match /rate_limits/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ─── Parent-Teacher Notes ──────────────────────────
    // Notes about a student, written by either parent or teacher.
    // Reads: any signed-in user (until parent↔student linkage exists,
    //   we can't tighten further without locking out educators who
    //   should see notes about students in their classroom).
    // Create: must stamp the writer's uid as author_uid (no impersonation).
    // Update: only the original author may edit.
    // Delete: only the original author may delete.
    match /parent_teacher_notes/{studentId}/notes/{noteId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.author_uid == request.auth.uid;
      allow update, delete: if isOwner(resource.data.author_uid);
    }

    // ─── Home Groups (parent-owned, parallel to classrooms) ──
    // Reads are open so children can look up by code at join time.
    // Writes are gated on the writer owning the parent profile that
    // owns the group.
    match /home_groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && ownsProfile(request.resource.data.owner_profile_id);
      allow update, delete: if signedIn()
        && ownsProfile(resource.data.owner_profile_id);
    }

    // ─── Home group membership ────────────────────────
    // The owning parent may add/remove anyone; a profile owner may
    // add/remove themselves (child-initiated join/leave).
    match /home_group_members/{memberId} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        ownsHomeGroupOwner(request.resource.data.home_group_id)
        || ownsProfile(request.resource.data.profile_id)
      );
      allow update: if signedIn() && (
        ownsHomeGroupOwner(resource.data.home_group_id)
        || ownsProfile(resource.data.profile_id)
      );
      allow delete: if signedIn() && (
        ownsHomeGroupOwner(resource.data.home_group_id)
        || ownsProfile(resource.data.profile_id)
      );
    }

    // ─── Live Classroom / Home-group Session ───────────
    // Session doc keyed by classroom id (teacher) or home-group id (parent).
    // Only the host (classroom teacher OR home-group owner) may create /
    // update / end it; any signed-in user can read (learners subscribe).
    match /live_sessions/{sessionKey} {
      allow read: if signedIn();
      allow create: if signedIn()
        && ownsLiveSession(sessionKey)
        && request.resource.data.owner_uid == request.auth.uid;
      allow update: if signedIn() && ownsLiveSession(sessionKey);
      allow delete: if signedIn() && ownsLiveSession(sessionKey);

      // Learner responses to a pushed activity. Anyone signed in may read
      // (the host dashboard subscribes to the live count + scoreboard); a
      // learner may write their own response (owner_uid match), and the
      // host may overwrite/clear if needed.
      match /responses/{responseId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.owner_uid == request.auth.uid;
        allow update: if signedIn() && (
          isOwner(resource.data.owner_uid)
          || ownsLiveSession(sessionKey)
        );
        allow delete: if signedIn() && ownsLiveSession(sessionKey);
      }

      // Raised hands. One doc per learner (id == profileId). A learner may
      // raise / lower their own hand (owner_uid match); the host may clear
      // any hand. Reads are open to signed-in users so the host dashboard
      // and the TV bridge can subscribe.
      match /hands/{profileId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.owner_uid == request.auth.uid;
        allow update: if signedIn() && (
          isOwner(resource.data.owner_uid)
          || ownsLiveSession(sessionKey)
        );
        allow delete: if signedIn() && (
          isOwner(resource.data.owner_uid)
          || ownsLiveSession(sessionKey)
        );
      }
    }

    // ─── Per-child time limits ─────────────────────────
    // One doc per child, keyed by childProfileId. Reads are open
    // (the child's device needs to read its own limit; educators
    // need to see what they configured). Writes require ownership
    // of the educator profile referenced by setter_profile_id.
    match /child_time_limits/{childProfileId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.owner_uid == request.auth.uid
        && ownsProfile(request.resource.data.setter_profile_id);
      allow delete: if signedIn()
        && ownsProfile(resource.data.setter_profile_id);
    }

    // ─── Per-child alarms ──────────────────────────────
    // Many docs per child. Same write semantics as child_time_limits.
    match /child_alarms/{alarmId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.owner_uid == request.auth.uid
        && ownsProfile(request.resource.data.setter_profile_id);
      allow delete: if signedIn()
        && ownsProfile(resource.data.setter_profile_id);
    }

    // ─── Per-child unlock overrides ────────────────────
    // One doc per child, keyed by childProfileId. Granted by an
    // educator (parent or teacher) to lift the lock screen for a
    // bounded window. Same write semantics as child_time_limits —
    // the writer must own the setter_profile_id.
    match /child_unlock_overrides/{childProfileId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.owner_uid == request.auth.uid
        && ownsProfile(request.resource.data.setter_profile_id);
      allow delete: if signedIn()
        && ownsProfile(resource.data.setter_profile_id);
    }

    // ─── Leaderboard config (classroom) ───────────────
    // One doc per classroom, id == classroomId. Holds the educator's
    // leaderboard settings (visible / metric / hidden members / period /
    // season). Members read (any signed-in user, so a student can honor
    // the config on their own device); only the owning teacher writes.
    // Mirrors the read-open / owner-write shape of child_time_limits.
    match /leaderboard_config_classroom/{classroomId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.owner_uid == request.auth.uid
        && ownsClassroomTeacher(classroomId);
      allow delete: if signedIn()
        && ownsClassroomTeacher(classroomId);
    }

    // ─── Leaderboard config (home group) ──────────────
    // Parallel to the classroom config — one doc per home group, id ==
    // homeGroupId. Only the owning parent writes.
    match /leaderboard_config_homegroup/{groupId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.owner_uid == request.auth.uid
        && ownsHomeGroupOwner(groupId);
      allow delete: if signedIn()
        && ownsHomeGroupOwner(groupId);
    }

    // ─── Active time logs (child-written daily counter) ─
    // The child's device writes here every ~5 minutes. Educators
    // on other devices read for the dashboard "X / Y min today"
    // pill. Owner is the child profile (the writer must own it).
    match /active_time_logs/{logId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.owner_uid == request.auth.uid
        && ownsProfile(request.resource.data.child_profile_id);
      allow delete: if signedIn()
        && ownsProfile(resource.data.child_profile_id);
    }

    // ─── Direct Messages (profile ↔ profile) ──────────
    // Top-level collection — each doc represents one message between two
    // profiles. The schema (see [CloudMessageRepository]):
    //   sender_profile_id, recipient_profile_id, sender_uid,
    //   sender_name, content, type, timestamp, is_read
    //
    // Visibility model:
    //   • Read: any signed-in user. Threads are scoped client-side via
    //     `where('sender_profile_id', ...)` / `where('recipient_profile_id', ...)`.
    //     We deliberately don't tighten reads further because the
    //     profile-↔-profile pairing already constrains what the client
    //     queries, and many educator devices read on behalf of multiple
    //     profiles they own. Tightening would require composite indexes
    //     keyed on owner_uid + profile_id which the Spark console can't
    //     auto-create without manual intervention. Acceptable for a
    //     classroom-scoped pilot; revisit if the deployment grows.
    //   • Create: writer must stamp their own uid as `sender_uid` and
    //     must own the `sender_profile_id` (no impersonation).
    //   • Update: ONLY the message recipient may patch `is_read`, and
    //     ONLY `is_read` may change.
    //   • Delete: the sender (owner of `sender_profile_id`) may delete.
    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.sender_uid == request.auth.uid
        && ownsProfile(request.resource.data.sender_profile_id);
      allow update: if signedIn()
        && ownsProfile(resource.data.recipient_profile_id)
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['is_read']);
      allow delete: if signedIn()
        && ownsProfile(resource.data.sender_profile_id);
    }

    // ─── Profile directory (username → profileId lookup) ──
    // Doc id is the lowercased username. Reads are open to any signed-in
    // user (friend-add by username has to resolve the handle without
    // already knowing whose profile it is). Writes require the caller to
    // own the profile referenced by `profile_id` and to stamp themselves
    // as `owner_uid`.
    match /profile_directory/{username} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.owner_uid == request.auth.uid
        && ownsProfile(request.resource.data.profile_id);
      allow delete: if signedIn() && isOwner(resource.data.owner_uid);
    }

    // ─── Friend requests (pending → accepted/rejected) ────
    // Composite id `{fromProfileId}_{toProfileId}` makes resends
    // idempotent at the Firestore level. Reads are open to any
    // signed-in user — doc IDs are sorted-pair UUIDs (not enumerable)
    // and the body holds only profile ids + status + the sender's own
    // display name. This shape lets `sendRequest`'s pre-existence
    // check work on docs that don't exist yet (where `resource` is
    // null, so any `resource.data.*` reference would otherwise deny).
    // Mirrors the open-read policy used by `messages/{id}` below.
    // Only the sender may create (and must own from_profile_id and
    // stamp from_owner_uid); the recipient or the sender may patch
    // `status` (recipient accepts/rejects; sender cancels) — and ONLY
    // `status` and `updated_at` may change. Sender may delete.
    match /friend_requests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.from_owner_uid == request.auth.uid
        && ownsProfile(request.resource.data.from_profile_id)
        && request.resource.data.status == 'pending';
      allow update: if signedIn() && (
          ownsProfile(resource.data.to_profile_id)
          || ownsProfile(resource.data.from_profile_id)
        )
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'updated_at']);
      allow delete: if signedIn()
        && ownsProfile(resource.data.from_profile_id);
    }

    // ─── Friendships (accepted, sorted-pair doc id) ───────
    // Single doc per relationship (id is `{minId}_{maxId}` so the same
    // pair always resolves to the same doc regardless of who initiated).
    // Reads are open to any signed-in user — the doc id is an
    // unguessable sorted UUID pair, and the body carries only profile
    // ids + a timestamp. The open read also lets `sendRequest`'s
    // pre-existence `get()` succeed for non-existent docs (where
    // `resource == null` would otherwise deny). Create is gated on
    // the writer owning at least one of the two profiles in the pair
    // — typically the acceptor, who batches this create alongside the
    // request status update.
    match /friendships/{friendshipId} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        ownsProfile(request.resource.data.profile_a)
        || ownsProfile(request.resource.data.profile_b)
      );
      allow delete: if signedIn() && (
        ownsProfile(resource.data.profile_a)
        || ownsProfile(resource.data.profile_b)
      );
    }

    // ─── Blocks (one-sided, directional) ─────────────────
    // Doc id is `{blockerProfileId}_{blockedProfileId}`. A block is the
    // learner's own safeguarding switch, so ONLY the blocker may read,
    // write, or clear it: unlike friendships this must NOT be readable
    // by the other party — "who blocked me" is exactly the signal a
    // bully would go looking for. The client queries its own blocks
    // with a single-field `where('blocker_profile_id', ==)`, which the
    // read rule below permits because the blocker owns that profile.
    match /blocks/{blockId} {
      allow read: if signedIn() && ownsProfile(resource.data.blocker_profile_id);
      allow create, update: if signedIn()
        && request.resource.data.blocker_uid == request.auth.uid
        && ownsProfile(request.resource.data.blocker_profile_id);
      allow delete: if signedIn()
        && ownsProfile(resource.data.blocker_profile_id);
    }

    // ─── Safeguarding reports ────────────────────────────
    // Write-only from the app: a child files a report, and nobody in the
    // client can read them back (review happens in the Firebase console,
    // where a grown-up can see the reporter, the reported profile, and
    // the sample message). Denying read also means a reported user can
    // never discover that they were reported.
    match /message_reports/{reportId} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.reporter_uid == request.auth.uid
        && ownsProfile(request.resource.data.reporter_profile_id);
      allow update, delete: if false;
    }

    // ─── Multiplayer game rooms ("Play Together") ─────────
    // One doc per online match. The host writes the shared game content
    // (questions / memory layout) into the room; both players race their
    // own copy and write only their own `players/{profileId}` doc. Reads
    // are open to any signed-in user (the invited friend discovers the
    // room via a single-field `where('invited_profile_id', ==)` query, and
    // both clients subscribe to live state) — the doc id is an unguessable
    // UUID and the body carries no PII beyond display names. Star-free:
    // nothing here touches progress/stars.
    //   • Create: host must stamp their own uid as both host_uid and
    //     owner_uid, and own host_profile_id (no impersonation).
    //   • Update: the host, the invited friend (to join), or a joined
    //     guest may update (status transitions + guest fields + cancel).
    //   • Delete: host only (cleanup after the match).
    match /game_rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.host_uid == request.auth.uid
        && request.resource.data.owner_uid == request.auth.uid
        && ownsProfile(request.resource.data.host_profile_id);
      allow update: if signedIn() && (
        ownsProfile(resource.data.host_profile_id)
        || ownsProfile(resource.data.invited_profile_id)
        || (resource.data.guest_profile_id != null
            && ownsProfile(resource.data.guest_profile_id))
      );
      allow delete: if signedIn()
        && ownsProfile(resource.data.host_profile_id);

      // Live per-player score/progress. Each device writes only its own doc
      // (owner_uid match); the host may delete any during cleanup. Reads are
      // open so each client can watch the opponent's live progress.
      match /players/{profileId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.owner_uid == request.auth.uid;
        allow delete: if signedIn() && (
          isOwner(resource.data.owner_uid)
          || ownsProfile(
              get(/databases/$(database)/documents/game_rooms/$(roomId)).data.host_profile_id)
        );
      }
    }

    // ─── Recovery codes (cross-device profile restoration) ─
    // One doc per code. The doc id IS the human-shareable code (e.g.
    // `MNGO-BERY-7K`), giving O(1) lookup with no `where(...)` query.
    // Reads are open to any signed-in user: redemption is a lookup-by-id
    // happy path, and the caller must already know the code. Code data
    // is hashed (`code_hash` + `code_salt`) so the doc id alone is not
    // enough to "prove" possession — the hash check happens client-side
    // post-lookup. Used in tandem with [claimingViaRecovery] on
    // profiles / progress / custom_cards / shop_equipped / app_state.
    match /recovery_codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.profile_owner_uid == request.auth.uid
        && ownsProfile(request.resource.data.profile_id);
      // Updates are restricted to marking the code redeemed
      // (`used_at` + `redeemed_by_uid`). The code itself, profile_id,
      // and hash cannot be mutated post-creation.
      allow update: if signedIn()
        && resource.data.used_at == null
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['used_at', 'redeemed_by_uid']);
      // Owner may revoke; the redeeming party may not delete.
      allow delete: if signedIn()
        && resource.data.profile_owner_uid == request.auth.uid;
    }
  }
}
