# iOS 15.5 is the floor set by Google ML Kit (Word Hunt object labels and the
# Gaze Control face detector) - every other plugin supports older versions.
$iOSVersion = '15.5'
platform :ios, $iOSVersion

# file_picker: the app picks images (photo picker) and documents, never songs
# from the Music library. Leaving the audio picker out drops MediaPlayer, so
# App Review does not expect an Apple Music usage string.
Pod::PICKER_AUDIO = false

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  # Not the precompiled Firestore (invertase/firestore-ios-sdk-frameworks):
  # its 11.15.0 tag points FirebaseFirestoreAbseilBinary at an 11.9.0 archive
  # that no longer downloads, and pod install fails. Building Firestore from
  # source is slow (most of a ~20-minute first build) but works.

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # ML Kit ships 64-bit slices only.
      config.build_settings['EXCLUDED_ARCHS[sdk=iphoneos*]'] = 'armv7'
      # Pods that still declare an older floor would warn (or fail on newer
      # Xcode versions that dropped those SDKs); lift them to the app's.
      if Gem::Version.new($iOSVersion) > Gem::Version.new(config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] || '0')
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = $iOSVersion
      end
    end
  end
end
